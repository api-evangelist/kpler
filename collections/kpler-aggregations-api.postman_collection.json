          "name": "Aggregated commodity flows",
          "request": {
            "name": "Aggregated commodity flows",
            "description": {
              "content": "Returns aggregated flows for a point of interest (installation or zone) on a daily, weekly, weekly EIA (US), monthly, or yearly basis. Documented SDK-level filters include flow direction, split, granularity, date range, from/to installations and zones, products, unit, intra-country and intra-region inclusion, forecasts, and vessel types.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "flows"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "columns",
                  "value": "<string>",
                  "description": "Comma-separated list of columns to return (for example trade_id,vessel_name,start,end)."
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "<integer>",
                  "description": "Maximum number of rows to return."
                },
                {
                  "disabled": false,
                  "key": "fromZones",
                  "value": "<string>",
                  "description": "Origin zone filter (for example Europe)."
                },
                {
                  "disabled": false,
                  "key": "toZones",
                  "value": "<string>",
                  "description": "Destination zone filter (for example Asia)."
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<date>",
                  "description": "Start of the date range."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<date>",
                  "description": "End of the date range."
                },
                {
                  "disabled": false,
                  "key": "products",
                  "value": "<string>",
                  "description": "Product filter (for example crude, gasoline, LNG)."
                },
                {
                  "disabled": false,
                  "key": "granularity",
                  "value": "<string>",
                  "description": "Aggregation granularity (daily, weekly, monthly, yearly)."
                },
                {
                  "disabled": false,
                  "key": "flowDirection",
                  "value": "<string>",
                  "description": "Direction of the flow relative to the point of interest (import/export)."
                },
                {
                  "disabled": false,
                  "key": "split",
                  "value": "<string>",
                  "description": "Dimension to split the aggregation by (for example product, origin, destination)."
                }
              ],
