          "name": "List trades",
          "request": {
            "name": "List trades",
            "description": {
              "content": "Returns cargo trades observed on the platform, with selectable columns (for example trade_id, vessel_name, start, end) and origin/destination zone filters. Kpler recommends querying this endpoint no more than once per hour and running queries sequentially.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "trades"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "columns",
                  "value": "<string>",
                  "description": "Comma-separated list of columns to return (for example trade_id,vessel_name,start,end)."
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "<integer>",
                  "description": "Maximum number of rows to return."
                },
                {
                  "disabled": false,
                  "key": "fromZones",
                  "value": "<string>",
                  "description": "Origin zone filter (for example Europe)."
                },
                {
                  "disabled": false,
                  "key": "toZones",
                  "value": "<string>",
                  "description": "Destination zone filter (for example Asia)."
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<date>",
                  "description": "Start of the date range."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<date>",
                  "description": "End of the date range."
                },
                {
                  "disabled": false,
                  "key": "products",
                  "value": "<string>",
                  "description": "Product filter (for example crude, gasoline, LNG)."
                }
              ],
              "variable": []
            },
